## Client-side (safe to expose — Vite only ships VITE_-prefixed vars, and
## Postgres RLS is the real access-control boundary, not anon-key secrecy)
VITE_SUPABASE_URL=PLACEHOLDER_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=PLACEHOLDER_SUPABASE_ANON_KEY

## Server-only (read exclusively inside /api/*.ts — never VITE_-prefixed,
## never imported from client code). Only needed locally if you run
## `vercel dev`; otherwise set these in the Vercel dashboard.
GEMINI_API_KEY=PLACEHOLDER_GEMINI_API_KEY
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER_SUPABASE_SERVICE_ROLE_KEY
